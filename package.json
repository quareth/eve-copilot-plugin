{
  "name": "eve-copilot-mcp",
  "version": "0.1.8",
  "description": "Local MCP capability runtime installed by the EVE Copilot setup skill",
  "homepage": "https://github.com/quareth/eve-copilot-plugin",
  "repository": "https://github.com/quareth/eve-copilot-plugin",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "eve-copilot-mcp": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "files": [
    "dist",
    "vendor/dogma-engine",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs/attribution.md",
    "docs/esi-coverage.md",
    "docs/esi-coverage.json",
    "docs/capability-catalog.md",
    "docs/scope-bundles.md",
    "docs/action-safety.md",
    "docs/eve-guide.md",
    "docs/privacy.md",
    "docs/troubleshooting.md",
    "docs/limitations.md",
    "docs/plugin-system.md",
    "docs/client-setup"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/finalize-build.mjs",
    "clean": "node scripts/clean.mjs",
    "dev": "tsx src/cli/main.ts serve",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:compat": "vitest run tests/contract && npm run build && npm run test:package",
    "test:package": "node scripts/package-smoke.mjs",
    "check:generated": "node scripts/check-generated-esi.mjs",
    "check:plugin": "node scripts/check-plugin-structure.mjs",
    "check:coverage": "node scripts/check-esi-coverage-closure.mjs",
    "check:openapi-drift": "node scripts/check-openapi-drift.mjs",
    "audit:public": "node scripts/public-artifact-audit.mjs",
    "audit:secrets": "node scripts/secret-scan.mjs",
    "check": "npm run check:plugin && npm run check:generated && npm run check:coverage && npm run check:openapi-drift && npm run typecheck && npm run lint && npm test && npm run build && npm run audit:public && npm run audit:secrets && npm run test:package"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@zip.js/zip.js": "2.8.54",
    "better-sqlite3": "13.0.3",
    "jose": "6.2.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.10.1",
    "eslint": "10.8.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "1.3.0"
  }
}
